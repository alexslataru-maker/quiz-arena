
* {
  box-sizing: border-box;
}

body {
  margin: 0;
  padding: 16px;
  min-height: 100vh;
  background: #080d20;
  color: #f7f8ff;
  font-family: Arial, sans-serif;
}

.game {
  width: 100%;
  max-width: 520px;
  margin: 0 auto;
  padding: 22px;
  border: 1px solid #28365e;
  border-radius: 24px;
  background: linear-gradient(160deg, #17234b, #0e1430);
  box-shadow: 0 18px 50px #0006;
}

.top, .info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
}

.logo {
  font-weight: 900;
  font-size: 18px;
  color: #82aaff;
}

.score-box {
  background: #25345e;
  padding: 10px;
border-radius: 12px;
  font-size: 14px;
}

.progress {
  height: 8px;
  background: #303958;
  border-radius: 20px;
  overflow: hidden;
  margin: 24px 0;
}

#progressBar {
  height: 100%;
  width: 0;
  background: linear-gradient(90deg, #5d7cff, #44e4c0);
  transition: width .25s;
}

.info {
  font-size: 12px;
  color: #bdc8ef;
}
#category {
  color: #7fe5cf;
  font-weight: bold;
}

h1 {
  font-size: 25px;
  line-height: 1.35;
  margin: 26px 0;
}

#answers {
  display: grid;
  gap: 12px;
}
}

#feedback {
  min-height: 24px;
  font-weight: bold;
  line-height: 1.5;
}

#next, #restart {
  color: #071328;
  background: linear-gradient(90deg, #85a6ff, #63e9c7);
  margin-top: 10px;
}

button.secondary {
  margin-top: 10px;
  background: #25345b;
  color: #e4eaff;
}
#final {
  text-align: center;
  padding: 20px 0;
}

#final h2 {
  font-size: 28px;
}

.trophy {
  font-size: 65px;
}

footer {
  margin-top: 28px;
  padding-top: 16px;
  border-top: 1px solid #344064;
  color: #aebbe2;
  text-align: center;
  font-size: 13px;
}

[hidden] {
  display: none !important;
}

@media (max-width: 380px) {
  .game {
    padding: 16px;
  }
h1 {
    font-size: 21px;
  }

  .logo {
    font-size: 15px;
  }
}

